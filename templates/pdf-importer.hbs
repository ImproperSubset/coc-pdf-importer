<section class="standard-form longer-labels scrollable">
  <fieldset>
    <legend>{{localize 'coc-pdf-importer.Settings.Name'}}</legend>
    <div class="form-group">
      <label>{{localize 'coc-pdf-importer.Form.Upload'}}</label>
      <p class="hint">{{localize 'coc-pdf-importer.Settings.Hint'}}</p>
      <input type="file" id="file-upload" name="files" accept="application/pdf,.pdf" multiple />
    </div>
    <div class="coc-book-titles"></div>
    <div class="form-group">
      <label>{{localize 'coc-pdf-importer.Form.Era'}}</label>
      <select name="era">
        <option value="classic" {{#unless pulp}}selected{{/unless}}>{{localize 'coc-pdf-importer.Form.EraClassic'}}</option>
        <option value="pulp" {{#if pulp}}selected{{/if}}>{{localize 'coc-pdf-importer.Form.EraPulp'}}</option>
      </select>
      <p class="hint">{{localize 'coc-pdf-importer.Form.EraHint'}}</p>
    </div>
  </fieldset>
</section>